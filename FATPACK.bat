@echo off
chcp 65001 >nul
title 肥鱼一键安装器
cd /d "%~dp0"
setlocal enabledelayedexpansion

echo.
echo ============================================================
echo    肥鱼 (FatFish) 一键安装器
echo    自动安装肥鱼运行所需的全部前置环境
echo ============================================================
echo.

REM ============================================================
REM  1) 检查 Python
REM ============================================================
echo [1/6] 检查 Python 环境...
where python >nul 2>nul
if errorlevel 1 (
    echo.
    echo   [X] 未检测到 Python！
    echo.
    echo   请先安装 Python 3.8 或更高版本：
    echo     1. 打开 https://www.python.org/downloads/
    echo     2. 下载并运行安装包
    echo     3. 安装时务必勾选 "Add Python to PATH"
    echo     4. 装完重新运行本安装器
    echo.
    pause
    exit /b 1
)
for /f "tokens=2" %%v in ('python --version 2^>^&1') do set PYVER=%%v
echo       [OK] 检测到 Python %PYVER%

REM ============================================================
REM  2) 释放程序文件（从本文件末尾提取内嵌的 base64）
REM ============================================================
echo.
echo [2/6] 释放肥鱼程序文件...
set "EXTRACT_PY=%TEMP%\fatfish_extract_%RANDOM%.py"
set "MK=##PY"
set "MK=!MK!BEGIN##"
powershell -NoProfile -Command "$c = Get-Content -LiteralPath '%~f0' -Raw; $i = $c.LastIndexOf('%MK%'); if ($i -lt 0) { exit 1 }; $c.Substring($i + 12) | Set-Content -LiteralPath '%EXTRACT_PY%' -Encoding UTF8"
if errorlevel 1 (
    echo   [X] 提取内嵌数据失败，安装器可能已损坏
    pause
    exit /b 1
)
python "%EXTRACT_PY%"
if errorlevel 1 (
    echo   [X] 程序文件释放失败
    del "%EXTRACT_PY%" >nul 2>nul
    pause
    exit /b 1
)
del "%EXTRACT_PY%" >nul 2>nul
echo       [OK] 核心文件已就位

REM ============================================================
REM  3) 创建虚拟环境
REM ============================================================
echo.
echo [3/6] 配置虚拟环境...
if exist "venv\Scripts\activate.bat" (
    echo       [OK] 虚拟环境已存在，跳过创建
) else (
    echo       正在创建 venv（首次约需 10-30 秒）...
    python -m venv venv
    if errorlevel 1 (
        echo       [!] venv 创建失败，将使用全局 Python 继续
    ) else (
        echo       [OK] 虚拟环境创建完成
    )
)
if exist "venv\Scripts\activate.bat" call "venv\Scripts\activate.bat"

REM ============================================================
REM  4) 安装依赖
REM ============================================================
echo.
echo [4/6] 安装依赖包（openai / python-dotenv / requests）...
python -c "import openai, dotenv, requests" >nul 2>nul
if errorlevel 1 (
    echo       正在升级 pip...
    python -m pip install --upgrade pip -q
    echo       正在从官方源安装依赖...
    python -m pip install openai python-dotenv requests -q
    if errorlevel 1 (
        echo       [!] 官方源失败，改用清华镜像重试...
        python -m pip install openai python-dotenv requests -i https://pypi.tuna.tsinghua.edu.cn/simple -q
        if errorlevel 1 (
            echo.
            echo   [X] 依赖安装失败！请检查网络后重试，或手动执行：
            echo       python -m pip install openai python-dotenv requests
            echo.
            pause
            exit /b 1
        )
    )
    echo       [OK] 依赖安装完成
) else (
    echo       [OK] 依赖已就绪，跳过安装
)

REM ============================================================
REM  5) 生成 .env 配置模板
REM ============================================================
echo.
echo [5/6] 检查配置文件...
if exist ".env" (
    echo       [OK] 已存在 .env，保留原配置
) else (
    (
        echo # 肥鱼配置文件 —— 请把占位符替换成你自己的 API Key
        echo # DeepSeek 申请：https://platform.deepseek.com/
        echo # Tavily  申请：https://tavily.com/
        echo DEEPSEEK_API_KEY=sk-在这里填入你的deepseek密钥
        echo TAVILY_API_KEY=tvly-在这里填入你的tavily密钥
    ) > ".env"
    echo       [OK] 已生成 .env 模板
    echo.
    echo   [!] 重要：请用记事本打开 .env，填入你的 API Key 后再启动肥鱼！
    echo.
    start notepad ".env"
)

REM ============================================================
REM  6) 自检
REM ============================================================
echo.
echo [6/6] 运行自检...
python -c "import openai, dotenv, requests, net_tools, file_tools, workspace, exec_tools; print('      [OK] 所有模块导入正常')"
if errorlevel 1 echo   [!] 自检未通过，请检查上述报错

echo.
echo ============================================================
echo    安装完成！
echo ------------------------------------------------------------
echo    下一步：
echo      1. 确认 .env 里已填好 API Key
echo      2. 双击 "fatfish1.0.3.bat" 启动肥鱼
echo ============================================================
echo.
pause
exit /b 0


<!--
  ============================================================================
   Cheat Engine 7.5 风格主题（浅色 · 桌面工具感）
  ============================================================================

   色值全部来自对 CE 7.5 主窗口截图的像素取样，不是凭印象调的：

     窗口底 / 内容区   #FCFCFC       工具栏 / 状态栏   #F0F0F0
     强分隔线          #BCBCBC       弱分隔线 / 分栏   #E6E6E6 / #EAEAEA
     正文              #1A1A1A       次要文字          #6D6D6D
     选中背景          #C8E0F0       悬停背景          #E8E8E8

   设计要点（照抄 CE 的做法）：
     1. 大面积中性灰，不用色块分区，靠 1px 细线切分区域
     2. 图标是唯一的彩色元素，24px 左右，扁平无边框，悬停才浮出
     3. 面板都有「标题条」——浅灰渐变 + 底部 1px 深线
     4. 输入框是下凹的（上/左深、下/右白），经典 Win32 观感
     5. 状态栏分格显示，格与格之间有竖线

   换肤提示：改下面「色板」这一段就够了，其余样式全部引用这些键。

   ★ 引用约定：<Color> 键（*Color）只给 Color 属性用；
     所有 Brush 类属性（Background/Foreground/Stroke/Fill/BorderBrush）
     一律引用画刷键（Accent / FgMuted / LineStrong …），不要引用 *Color，
     否则运行时资源解析会抛异常。
  ============================================================================
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================== 色板 ==================== -->

    <Color x:Key="BgBaseColor">#FFFCFCFC</Color>
    <Color x:Key="BgPanelColor">#FFF0F0F0</Color>
    <Color x:Key="BgInputColor">#FFFFFFFF</Color>
    <Color x:Key="FgPrimaryColor">#FF1A1A1A</Color>
    <Color x:Key="FgMutedColor">#FF6D6D6D</Color>
    <Color x:Key="AccentColor">#FF2F7BBF</Color>
    <Color x:Key="WarnColor">#FFB57300</Color>
    <Color x:Key="DangerColor">#FFC0392B</Color>
    <Color x:Key="UserBubbleColor">#FFF6F9FC</Color>
    <Color x:Key="AiBubbleColor">#FFFFFFFF</Color>

    <!-- 语义化画刷（沿用旧键名，审批窗口等无需改动） -->
    <SolidColorBrush x:Key="BgBase" Color="{StaticResource BgBaseColor}" />
    <SolidColorBrush x:Key="BgPanel" Color="{StaticResource BgPanelColor}" />
    <SolidColorBrush x:Key="BgInput" Color="{StaticResource BgInputColor}" />
    <SolidColorBrush x:Key="FgPrimary" Color="{StaticResource FgPrimaryColor}" />
    <SolidColorBrush x:Key="FgMuted" Color="{StaticResource FgMutedColor}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="Warn" Color="{StaticResource WarnColor}" />
    <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="UserBubble" Color="{StaticResource UserBubbleColor}" />
    <SolidColorBrush x:Key="AiBubble" Color="{StaticResource AiBubbleColor}" />

    <!-- CE 专用画刷 -->
    <SolidColorBrush x:Key="Chrome" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="Surface" Color="#FFFCFCFC" />
    <SolidColorBrush x:Key="SurfaceWhite" Color="#FFFFFFFF" />

    <SolidColorBrush x:Key="LineStrong" Color="#FFBCBCBC" />
    <SolidColorBrush x:Key="Line" Color="#FFD9D9D9" />
    <SolidColorBrush x:Key="LineSoft" Color="#FFECECEC" />
    <SolidColorBrush x:Key="SplitLine" Color="#FFEAEAEA" />

    <SolidColorBrush x:Key="SelBack" Color="#FFC8E0F0" />
    <SolidColorBrush x:Key="HoverBack" Color="#FFE8E8E8" />
    <SolidColorBrush x:Key="PressBack" Color="#FFD5D5D5" />

    <!-- 说话人色条：CE 本身没有，但聊天需要一眼分清谁在说 -->
    <SolidColorBrush x:Key="VoiceUser" Color="#FF2F7BBF" />
    <SolidColorBrush x:Key="VoiceAi" Color="#FF7C8A3F" />
    <SolidColorBrush x:Key="VoiceSystem" Color="#FFA8A8A8" />

    <!-- 图标彩色（对应 CE 工具栏那批彩色小图标） -->
    <SolidColorBrush x:Key="IconGreen" Color="#FF3E8E41" />
    <SolidColorBrush x:Key="IconRed" Color="#FFC0392B" />
    <SolidColorBrush x:Key="IconAmber" Color="#FFE0A422" />
    <SolidColorBrush x:Key="IconBlue" Color="#FF2F7BBF" />
    <SolidColorBrush x:Key="IconGray" Color="#FF7A7A7A" />
    <SolidColorBrush x:Key="IconViolet" Color="#FF7B5EA7" />

    <!--
      ★ 2026-10-30 控件细节画刷：这些色原先**写死在下面各个模板里**（Value="#FFEDEDED" 之类）。
        写死的色值换肤时不会跟着变 —— 切到夜间会剩下一堆惨白的按钮，所以全部提出来做成键。
        以后改样式请一律引用键，别在模板里写 #RRGGBB。
    -->
    <SolidColorBrush x:Key="FgDisabled" Color="#FFA8A8A8" />

    <SolidColorBrush x:Key="BtnFace" Color="#FFEDEDED" />
    <SolidColorBrush x:Key="BtnBorder" Color="#FF8A8A8A" />
    <SolidColorBrush x:Key="BtnHoverFace" Color="#FFF7F7F7" />
    <SolidColorBrush x:Key="BtnHoverBorder" Color="#FF5A5A5A" />
    <SolidColorBrush x:Key="BtnPressFace" Color="#FFDCDCDC" />

    <SolidColorBrush x:Key="ToolHoverFace" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="ToolHoverBorder" Color="#FFB8B8B8" />
    <SolidColorBrush x:Key="ToolPressFace" Color="#FFDCDCDC" />
    <SolidColorBrush x:Key="ToolPressBorder" Color="#FF9A9A9A" />

    <!-- 输入框三层下凹：上/左深、下/右白、外框灰 -->
    <SolidColorBrush x:Key="InputBorder" Color="#FF8B8B8B" />
    <SolidColorBrush x:Key="InputEdge" Color="#FF7F7F7F" />
    <SolidColorBrush x:Key="InputEdgeLight" Color="#FFFFFFFF" />

    <SolidColorBrush x:Key="ListHoverFace" Color="#FFF0F4F7" />
    <SolidColorBrush x:Key="TabFace" Color="#FFE2E2E2" />
    <SolidColorBrush x:Key="TabHoverFace" Color="#FFEDEDED" />

    <!--
      主色按钮的描边。原先审批窗 / 配置编辑器里写死成 BorderBrush="#FF1E5A91"，
      切夜间不会跟着变，所以提成键（日间保持原值，夜间换成暗一档的蓝）。
    -->
    <SolidColorBrush x:Key="AccentBorder" Color="#FF1E5A91" />

    <!--
      ★ 2026-10-30 滚动条专用色：原先 ScrollBar 没样式，走的是系统 Aero 主题 ——
        一片浅灰 + 立体箭头，切到夜间就是整条亮疤。这里补一套扁平的 CE 风，
        和别处一样只引用键，颜色由 ThemeManager 的暗色表一起换。
    -->
    <SolidColorBrush x:Key="ScrollTrack" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#FFC8C8C8" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#FFA8A8A8" />
    <SolidColorBrush x:Key="ScrollThumbPress" Color="#FF8A8A8A" />
    <SolidColorBrush x:Key="ScrollArrow" Color="#FF6D6D6D" />

    <!-- 面板标题条：浅灰渐变 + 底边深线 -->
    <LinearGradientBrush x:Key="HeaderFace" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFAFAFA" Offset="0" />
        <GradientStop Color="#FFE4E4E4" Offset="1" />
    </LinearGradientBrush>

    <!-- ==================== 字体 ==================== -->

    <FontFamily x:Key="UiFont">Microsoft YaHei UI, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New, monospace</FontFamily>
    <!-- Windows 10/11 内置的图标字体，矢量、可着色，比贴 PNG 清爽 -->
    <FontFamily x:Key="IconFont">Segoe MDL2 Assets, Segoe Fluent Icons</FontFamily>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Foreground" Value="{DynamicResource FgPrimary}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <!-- ==================== 菜单 ==================== -->

    <Style x:Key="CeMenu" TargetType="Menu">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource FgPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="4,1" />
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource FgPrimary}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="Bd"
                                Background="Transparent"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Path x:Name="Check"
                                      Grid.Column="0"
                                      Data="M0,4 L3,7.5 L9,0"
                                      Stroke="{DynamicResource Accent}"
                                      StrokeThickness="1.6"
                                      Visibility="Collapsed"
                                      VerticalAlignment="Center"
                                      Margin="0,0,7,0" />

                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center" />

                                <Path x:Name="Arrow"
                                      Grid.Column="2"
                                      Data="M0,0 L4,4 L0,8"
                                      Stroke="{DynamicResource FgMuted}"
                                      StrokeThickness="1.2"
                                      Visibility="Collapsed"
                                      VerticalAlignment="Center"
                                      Margin="16,0,2,0" />
                            </Grid>
                        </Border>

                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsSubmenuOpen}"
                               AllowsTransparency="False"
                               Focusable="False"
                               PopupAnimation="None">
                            <Border Background="{DynamicResource SurfaceWhite}"
                                    BorderBrush="{DynamicResource LineStrong}"
                                    BorderThickness="1"
                                    Padding="2"
                                    SnapsToDevicePixels="True">
                                <StackPanel IsItemsHost="True"
                                            KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </Border>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="PART_Popup" Property="Placement" Value="Right" />
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuItem">
                            <Setter Property="Padding" Value="10,5" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelBack}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource FgDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      ★ 2026-10-30：ContextMenu（右键菜单 / 顶栏按钮弹出的菜单）**原先没有样式** ——
        MenuItem 的模板只管条目本身，弹层那层 Border 是系统画的（白底 + 灰边）。
        夜间模式下：白底 + 我们的浅色字，等于看不清。这里补上。
        Menu 自己那一套（CeMenu + MenuItem 的 Popup）不受影响，两者互不覆盖。
    -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource SurfaceWhite}" />
        <Setter Property="Foreground" Value="{DynamicResource FgPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <StackPanel IsItemsHost="True"
                                    KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="20,3,4,3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{DynamicResource Line}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 按钮 ==================== -->

    <!-- 普通按钮：CE 的经典「凸起」灰按钮 -->
    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource FgPrimary}" />
        <Setter Property="Background" Value="{DynamicResource BtnFace}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BtnBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BtnHoverFace}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BtnHoverBorder}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BtnPressFace}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 工具栏图标按钮：平时完全透明，悬停才浮出边框（CE 的准则） -->
    <Style x:Key="ToolButton" TargetType="Button">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="26" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ToolHoverFace}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ToolHoverBorder}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BtnPressFace}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ToolPressBorder}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.32" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 工具栏竖分隔线 -->
    <Style x:Key="ToolSep" TargetType="Rectangle">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Fill" Value="{DynamicResource LineStrong}" />
        <Setter Property="Margin" Value="5,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ==================== 输入框（下凹） ==================== -->

    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource FgPrimary}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceWhite}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="5,4" />
        <Setter Property="CaretBrush" Value="{DynamicResource FgPrimary}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource SelBack}" />
        <Setter Property="SelectionOpacity" Value="0.85" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <!-- 经典下凹：外框上/左深灰，内框下/右白 —— 制造 1px 立体感 -->
                    <Border BorderBrush="{DynamicResource InputEdge}" BorderThickness="1,1,0,0" SnapsToDevicePixels="True">
                        <Border BorderBrush="{DynamicResource InputEdgeLight}" BorderThickness="0,0,1,1" SnapsToDevicePixels="True">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalScrollBarVisibility="Auto" />
                            </Border>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 列表 ==================== -->

    <Style x:Key="CeListBox" TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceWhite}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource FgPrimary}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="CeListBoxItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ListHoverFace}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelBack}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 树 ==================== -->

    <Style TargetType="TreeViewItem">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource FgPrimary}" />
        <Setter Property="Padding" Value="2,1" />
    </Style>

    <!-- ==================== 选项卡 ==================== -->

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="{DynamicResource SurfaceWhite}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="{DynamicResource Chrome}"
                                BorderBrush="{DynamicResource LineStrong}"
                                BorderThickness="0,0,0,1">
                            <StackPanel IsItemsHost="True"
                                        Orientation="Horizontal"
                                        Margin="4,3,0,0"
                                        KeyboardNavigation.TabNavigation="Local" />
                        </Border>

                        <Border Grid.Row="1" Background="{TemplateBinding Background}">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              ContentSource="SelectedContent" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource FgMuted}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd"
                            Background="{DynamicResource TabFace}"
                            BorderBrush="{DynamicResource LineStrong}"
                            BorderThickness="1,1,1,0"
                            Margin="0,1,-1,0"
                            Padding="11,3"
                            SnapsToDevicePixels="True">
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabHoverFace}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceWhite}" />
                            <Setter TargetName="Bd" Property="Margin" Value="0,0,-1,-1" />
                            <Setter TargetName="Bd" Property="Padding" Value="11,4" />
                            <Setter Property="Foreground" Value="{DynamicResource FgPrimary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 分栏拖动条 ==================== -->

    <Style x:Key="CeSplitter" TargetType="GridSplitter">
        <Setter Property="Background" Value="{DynamicResource Chrome}" />
        <Setter Property="ShowsPreview" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ==================== 滚动条 ==================== -->
    <!--
      ★ 2026-10-30：这里原先**什么都没有**，ScrollBar 落回系统 Aero 模板（浅灰槽 + 立体按钮），
        切到夜间就是一条刺眼的亮疤。下面按 CE 的路子重画：扁平、无立体、1px 描边也不给。
        结构说明（WPF 的 ScrollBar 模板必须分方向各写一套）：
          · Vertical  → 上箭头 / Track（含 Thumb）/ 下箭头
          · Horizontal→ 左箭头 / Track / 右箭头
          颜色全部引用主题键，换肤自动跟着走；滑块/悬停/拖动三档色分开，拖动时才看得出反馈。
    -->

    <!-- 滑块 -->
    <Style x:Key="CeScrollThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="MinWidth" Value="26" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd"
                            Background="{DynamicResource ScrollThumb}"
                            SnapsToDevicePixels="True" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ScrollThumbHover}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ScrollThumbPress}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 轨道空白处（点击翻页）：平时完全透明，只给翻页手势用 -->
    <Style x:Key="CeScrollPage" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border x:Name="Bd" Background="Transparent" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBack}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 两头的小箭头按钮：箭头本身作为内容传进来，方向由调用处决定 -->
    <Style x:Key="CeScrollArrow" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border x:Name="Bd" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBack}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="{DynamicResource ScrollTrack}" />
        <Setter Property="Width" Value="14" />
        <Setter Property="MinWidth" Value="14" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <!-- 竖向 -->
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <RepeatButton Grid.Row="0" Height="14"
                                      Command="ScrollBar.LineUpCommand"
                                      Style="{StaticResource CeScrollArrow}">
                            <Path Data="M0,3 L4,0 L8,3"
                                  Stroke="{DynamicResource ScrollArrow}"
                                  StrokeThickness="1.2" />
                        </RepeatButton>

                        <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand"
                                              Style="{StaticResource CeScrollPage}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource CeScrollThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand"
                                              Style="{StaticResource CeScrollPage}" />
                            </Track.IncreaseRepeatButton>
                        </Track>

                        <RepeatButton Grid.Row="2" Height="14"
                                      Command="ScrollBar.LineDownCommand"
                                      Style="{StaticResource CeScrollArrow}">
                            <Path Data="M0,0 L4,3 L8,0"
                                  Stroke="{DynamicResource ScrollArrow}"
                                  StrokeThickness="1.2" />
                        </RepeatButton>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="14" />
                <Setter Property="MinHeight" Value="14" />
                <Setter Property="Template">
                    <Setter.Value>
                        <!-- 横向 -->
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <RepeatButton Grid.Column="0" Width="14"
                                              Command="ScrollBar.LineLeftCommand"
                                              Style="{StaticResource CeScrollArrow}">
                                    <Path Data="M3,0 L0,4 L3,8"
                                          Stroke="{DynamicResource ScrollArrow}"
                                          StrokeThickness="1.2" />
                                </RepeatButton>

                                <Track x:Name="PART_Track" Grid.Column="1" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand"
                                                      Style="{StaticResource CeScrollPage}" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource CeScrollThumb}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand"
                                                      Style="{StaticResource CeScrollPage}" />
                                    </Track.IncreaseRepeatButton>
                                </Track>

                                <RepeatButton Grid.Column="2" Width="14"
                                              Command="ScrollBar.LineRightCommand"
                                              Style="{StaticResource CeScrollArrow}">
                                    <Path Data="M0,0 L3,4 L0,8"
                                          Stroke="{DynamicResource ScrollArrow}"
                                          StrokeThickness="1.2" />
                                </RepeatButton>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ==================== 复选框 ==================== -->

    <!--
      ★ 2026-10-30：原先只设了前景色、没写模板，方框本身是系统 Aero 画的 ——
        深色界面里就是一个白方块（实测 Border bg #FFFFFFFF 13x13）。
        这里补一套扁平方框：底 SurfaceWhite、描边 InputBorder、勾用 Accent。
    -->
    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource FgPrimary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box"
                                Width="13" Height="13"
                                Background="{DynamicResource SurfaceWhite}"
                                BorderBrush="{DynamicResource InputBorder}"
                                BorderThickness="1"
                                VerticalAlignment="Center"
                                SnapsToDevicePixels="True">
                            <Path x:Name="Check"
                                  Data="M1.2,4.2 L3.6,6.8 L7.8,1.4"
                                  Stroke="{DynamicResource Accent}"
                                  StrokeThickness="1.6"
                                  Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="6,0,0,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BtnHoverBorder}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 密码框 ==================== -->
    <!--
      ★ 2026-10-30：原先**没有** PasswordBox 样式，审批档位 4 的口令框落回系统模板 ——
        白底黑字，在夜间界面里是一块亮斑（实测 #FFFFFFFF，420x26）。
        这里抄 TextBox 那套下凹外观，颜色全部走主题键。
    -->
    <Style TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource FgPrimary}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceWhite}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="5,4" />
        <Setter Property="CaretBrush" Value="{DynamicResource FgPrimary}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource SelBack}" />
        <Setter Property="SelectionOpacity" Value="0.85" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border BorderBrush="{DynamicResource InputEdge}" BorderThickness="1,1,0,0" SnapsToDevicePixels="True">
                        <Border BorderBrush="{DynamicResource InputEdgeLight}" BorderThickness="0,0,1,1" SnapsToDevicePixels="True">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                            </Border>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 下拉框 ==================== -->
    <!--
      ★ 2026-10-30：顶栏「审批」档位下拉框之前**没有任何样式**，落回系统 Aero ——
        白脸 + 立体箭头，在夜间界面里是最显眼的一块白。用户报的「上面那个审批没改」就是它。
        这里给一套扁平样式：脸 SurfaceWhite、描边 InputBorder、箭头 FgMuted、
        弹层 SurfaceWhite + LineStrong、高亮 SelBack —— 全是主题键，换肤自动跟。
    -->
    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource FgPrimary}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="PART_ToggleButton"
                                      Focusable="False"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd"
                                            Background="{DynamicResource SurfaceWhite}"
                                            BorderBrush="{DynamicResource InputBorder}"
                                            BorderThickness="1"
                                            SnapsToDevicePixels="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="18" />
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="1"
                                                  Data="M0,0 L4,4 L8,0"
                                                  Stroke="{DynamicResource FgMuted}"
                                                  StrokeThickness="1.2"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BtnHoverFace}" />
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BtnHoverBorder}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          Margin="6,0,22,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left" />

                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="None">
                            <Border Background="{DynamicResource SurfaceWhite}"
                                    BorderBrush="{DynamicResource LineStrong}"
                                    BorderThickness="1"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource FgPrimary}" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelBack}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource FgDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

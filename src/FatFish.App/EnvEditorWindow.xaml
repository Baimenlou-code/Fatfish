<Window x:Class="FatFish.App.EnvEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="配置 — .env"
        Height="860" Width="1360"
        MinHeight="520" MinWidth="820" Loaded="OnPlacementLoaded"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Chrome}"
        FontFamily="{StaticResource UiFont}"
        FontSize="12"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ToolTipService.InitialShowDelay="300"
        ToolTipService.ShowDuration="60000"
        ToolTipService.BetweenShowDelay="120">

    <!--
      ══════════════════════════════════════════════════════════════════════
        .env 可视化编辑器

        为什么要有这个窗口：
          这个程序的全部行为都由工作台根目录下那个 .env 决定 —— 用哪个模型、
          花哪个账号的钱、审查员是谁、生图能不能用。而它此前只能「用记事本打开」。
          记事本的问题不是丑，是**没有校验**：把温度写成 20、把地址少打一个 h、
          把 key 粘到注释行里，都能保存成功，然后表现为「程序莫名其妙不工作」。

        分工（很重要）：
          本窗口只负责「把控件摆出来、把输入收集起来」。
          解析 / 校验 / 写回 / 备份 / 体检全部在 FatFish.Core.Config 里，
          并且有单测覆盖（EnvDocumentTests / EnvSchemaTests）。
          窗口代码里**不该出现任何配置规则** —— 一旦规则长在窗口里，
          它就没法被测试，而「界面上填了、程序不认」正是这样长出来的。
      ══════════════════════════════════════════════════════════════════════
    -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== 标题条（与主窗口面板标题条同款） ===== -->
        <Border Grid.Row="0"
                Background="{DynamicResource HeaderFace}"
                BorderBrush="{DynamicResource LineStrong}"
                BorderThickness="0,0,0,1"
                Padding="10,6"
                ToolTip="这些配置控制程序的核心行为：用哪个模型、花哪个账号、要不要 AI 复核、生图插件连哪里。&#x0A;保存后**必须重启程序**才生效 —— 因为配置是在启动时一次性读进环境变量的。">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="&#xE713;"
                           FontFamily="{StaticResource IconFont}"
                           FontSize="14"
                           Foreground="{DynamicResource Accent}"
                           VerticalAlignment="Center"
                           Margin="0,0,7,0"
                           ToolTip="齿轮图标：这是一个设置窗口，改它不会动你的文件，只会改配置。" />

                <TextBlock Grid.Column="1"
                           Text="配置文件 .env"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           ToolTip="工作台根目录下的 .env。它是纯文本，一行一个 KEY=VALUE，以 # 开头的是注释。&#x0A;本窗口保存时会保留你原有的注释、空行和顺序，只改你动过的行。" />
            </Grid>
        </Border>

        <!-- ===== 工具条：搜索 + 显示密钥 + 高级项 ===== -->
        <Border Grid.Row="1"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Line}"
                BorderThickness="0,0,0,1"
                Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,10,0">
                    <TextBox x:Name="SearchBox"
                             Height="24"
                             VerticalContentAlignment="Center"
                             ToolTip="按「键名 / 名称 / 说明」过滤。&#x0A;例如输入 token、key、生图、核验。清空即可显示全部。" />
                    <TextBlock x:Name="SearchHint"
                               Text="搜索：键名 / 名称 / 说明…"
                               Foreground="{DynamicResource FgMuted}"
                               FontSize="11"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False" />
                </Grid>

                <CheckBox Grid.Column="1"
                          x:Name="RevealCheck"
                          Content="显示密钥明文"
                          Margin="0,0,14,0"
                          VerticalAlignment="Center"
                          Foreground="{DynamicResource FgMuted}"
                          ToolTip="默认把 API Key 显示成圆点，避免截图/录屏时泄露。&#x0A;勾选后显示明文；这个状态不会被保存，下次打开仍然是遮挡的。" />

                <CheckBox Grid.Column="2"
                          x:Name="AdvancedCheck"
                          Content="显示高级项"
                          VerticalAlignment="Center"
                          Foreground="{DynamicResource FgMuted}"
                          ToolTip="高级项平时不用改，改错的代价却不小（例如把回复上限调小会让长回答被截断）。&#x0A;它们仍然是可以改的，只是默认折叠起来，避免一屏几十个输入框吓人。" />
            </Grid>
        </Border>

        <!-- ===== 主体：表单 / 原文 ===== -->
        <TabControl Grid.Row="2" Margin="8,8,8,0">
            <TabItem Header="表单"
                     ToolTip="按用途分组编辑，每项下面有一句话说明「这是什么、改了会怎样」。&#x0A;保存时只写你动过的行，其余内容原样保留。">
                <ScrollViewer x:Name="FormScroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="2,2,10,2">
                    <StackPanel x:Name="FormHost" />
                </ScrollViewer>
            </TabItem>

            <TabItem Header="原文"
                     ToolTip="保存后的文件内容预览（只读）。&#x0A;想看注释、空行、顺序有没有被动过，看这里最快 —— 它们都应该和你手写时一模一样。">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{DynamicResource Surface}"
                            BorderBrush="{DynamicResource Line}"
                            BorderThickness="0,0,1,1"
                            Padding="8,5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="保存后会写成这样（只读预览）"
                                       FontSize="11"
                                       Foreground="{DynamicResource FgMuted}"
                                       VerticalAlignment="Center"
                                       ToolTip="这是「点保存之后」文件的样子，不是你当前磁盘上的内容。&#x0A;没动过的行会逐字节保持原样；动过的行会规范化成 KEY=VALUE（等号两侧的空格会被去掉）。" />
                            <Button x:Name="CopyRawButton"
                                    Content="复制"
                                    Height="20"
                                    Padding="8,0"
                                    Margin="10,0,0,0"
                                    FontSize="11"
                                    Click="OnCopyRaw"
                                    ToolTip="把这份预览复制到剪贴板。&#x0A;想手工备份、或贴到别处对比时用。" />
                        </StackPanel>
                    </Border>

                    <TextBox x:Name="RawBox"
                             Grid.Row="1"
                             IsReadOnly="True"
                             BorderThickness="0"
                             Background="{DynamicResource SurfaceWhite}"
                             Padding="8,6"
                             FontFamily="{StaticResource MonoFont}"
                             FontSize="11.5"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             ToolTip="只读：这里不能直接编辑。&#x0A;原因很实在 —— 两个地方都能改同一份内容，就一定会出现「表单里改了一半、原文里改了一半」，最后谁覆盖谁全靠运气。&#x0A;想改请回「表单」页；表单里没有的键会显示在「其他 / 自定义」分组里。" />
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ===== 体检结果 ===== -->
        <Border Grid.Row="3"
                Margin="8,8,8,0"
                Background="{DynamicResource SurfaceWhite}"
                BorderBrush="{DynamicResource Line}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{DynamicResource HeaderFace}"
                        BorderBrush="{DynamicResource Line}"
                        BorderThickness="0,0,0,1"
                        Padding="8,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="体检"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   ToolTip="保存前自动检查「跨键」的组合问题：两个 key 填了不同的值、换了审查员模型却没换地址、指定了后端却没给它 key……&#x0A;这类问题每一个键单看都合法，组合起来才表现为「余额对不上」「审查员 404」，所以必须在这里提示。" />
                        <TextBlock x:Name="IssueSummary"
                                   FontSize="11"
                                   Foreground="{DynamicResource FgMuted}"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="—" />
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1"
                              MaxHeight="96"
                              VerticalScrollBarVisibility="Auto"
                              Padding="8,4">
                    <StackPanel x:Name="IssueHost" />
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ===== 底栏 ===== -->
        <Border Grid.Row="4"
                Margin="0,8,0,0"
                Background="{DynamicResource Chrome}"
                BorderBrush="{DynamicResource LineStrong}"
                BorderThickness="0,1,0,0"
                Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText"
                               FontSize="11"
                               Foreground="{DynamicResource FgMuted}"
                               TextWrapping="Wrap"
                               ToolTip="操作结果、保存位置、备份路径都会显示在这里。&#x0A;备份文件名形如 .env.20261029_231500.bak —— 万一改错了，把它改名回 .env 就恢复了。" />
                    <TextBlock x:Name="PathText"
                               FontSize="10.5"
                               FontFamily="{StaticResource MonoFont}"
                               Foreground="{DynamicResource FgMuted}"
                               Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="这个窗口正在编辑的文件。&#x0A;如果它和你想改的不是同一个（比如工作台切换过、或有两份 .env），请先确认再保存。" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="OpenFolderButton"
                            Content="打开所在目录"
                            Height="28"
                            Padding="10,0"
                            Margin="0,0,8,0"
                            Click="OnOpenFolder"
                            ToolTip="在资源管理器里定位这个 .env。&#x0A;想手工备份、或想看看同目录还躺着几份 .bak 时用。" />

                    <Button x:Name="CancelButton"
                            Content="取消"
                            Width="88"
                            Height="28"
                            Margin="0,0,8,0"
                            Click="OnCancel"
                            ToolTip="放弃这次修改并关闭窗口。&#x0A;有未保存的改动时会先问你一次。&#x0A;磁盘上的 .env 不会被碰。" />

                    <Button x:Name="SaveButton"
                            Content="保存"
                            Width="88"
                            Height="28"
                            Margin="0,0,8,0"
                            Click="OnSave"
                            Background="{DynamicResource Accent}"
                            Foreground="White"
                            BorderBrush="{DynamicResource AccentBorder}"
                            ToolTip="校验通过后写入 .env，并自动备份原文件。&#x0A;保存后仍然需要重启程序才生效（配置在启动时一次性读入）。&#x0A;有任何一项校验不通过时，保存会被拦下并定位到那一项。" />

                    <Button x:Name="SaveRestartButton"
                            Content="保存并重启"
                            Height="28"
                            Padding="10,0"
                            Click="OnSaveAndRestart"
                            ToolTip="保存后立刻重启程序，让新配置马上生效。&#x0A;当前对话会中断：历史记录仍然在磁盘上，重启后可以继续，但未发送的草稿会丢。" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

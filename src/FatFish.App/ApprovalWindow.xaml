<Window x:Class="FatFish.App.ApprovalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="需要你的确认 — 肥鱼"
        Height="470" Width="620"
        MinHeight="360" MinWidth="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="{DynamicResource Chrome}"
        FontFamily="{StaticResource UiFont}"
        FontSize="12"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== 标题条（与主窗口面板标题条同款） ===== -->
        <Border Grid.Row="0"
                Background="{DynamicResource HeaderFace}"
                BorderBrush="{DynamicResource LineStrong}"
                BorderThickness="0,0,0,1"
                Padding="10,6"
                ToolTip="这是四道防线里的「人工报批」。&#x0A;模型想执行有副作用的动作（改文件、删文件、跑命令）时，会先停在这里，等你点头才动手。&#x0A;它前面还有一道审查员 AI：能走到这个窗口，说明 AI 没找出问题 —— 但它也可能看漏，最终判断权在你。">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}"
                           FontSize="14" Foreground="{DynamicResource Warn}"
                           VerticalAlignment="Center" Margin="0,0,7,0"
                           ToolTip="警告图标：下面这个动作会改动东西，不是只读。" />
                <TextBlock Text="内核请求执行一个需要确认的操作"
                           FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           ToolTip="「内核」＝正在跑的那套模型+工具循环。&#x0A;它自己不能直接动手，所有有副作用的动作都要经过你。" />
            </StackPanel>
        </Border>

        <!-- ===== 正文 ===== -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 元信息：工具名 + 原因 -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceWhite}"
                    BorderBrush="{DynamicResource Line}"
                    BorderThickness="1"
                    Padding="10,8"
                    Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="工具"
                               Foreground="{DynamicResource FgMuted}" FontSize="11"
                               Margin="0,0,12,5" VerticalAlignment="Top"
                               ToolTip="模型要调用的工具名。&#x0A;ws_ 开头＝工作台工具（读写文件、跑命令、管后台任务、查插件）；&#x0A;web_ 开头＝联网搜索 / 抓取；其余多为插件提供的工具。" />
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ToolText"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource Accent}"
                               Margin="0,0,0,5" TextWrapping="Wrap"
                               ToolTip="模型要调用的工具名。&#x0A;ws_ 开头＝工作台工具；web_ 开头＝联网；其余多为插件工具。" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="原因"
                               Foreground="{DynamicResource FgMuted}" FontSize="11"
                               Margin="0,0,12,0" VerticalAlignment="Top"
                               ToolTip="为什么这个动作需要你确认。&#x0A;常见几类：有副作用、涉及敏感文件（.env / 密钥）、命令可能越界、删除了东西。" />
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ReasonText"
                               FontSize="11" Foreground="{DynamicResource Warn}"
                               TextWrapping="Wrap"
                               ToolTip="策略给出的判定理由。&#x0A;如果理由和你看到的内容对不上，优先相信你看到的 —— 点「拒绝」，然后在对话里追问它。" />
                </Grid>
            </Border>

            <!-- 参数：保留可滚动的等宽视图，路径和长字符串不会被截断 -->
            <Border Grid.Row="1"
                    Background="{DynamicResource SurfaceWhite}"
                    BorderBrush="{DynamicResource Line}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{DynamicResource HeaderFace}"
                            BorderBrush="{DynamicResource Line}"
                            BorderThickness="0,0,0,1"
                            Padding="8,4">
                        <TextBlock Text="参数" FontSize="11" FontWeight="SemiBold"
                                   ToolTip="模型传给这个工具的原始参数（JSON）。&#x0A;核对「它到底要改哪个路径、改成什么内容」就靠这一栏 —— 标题里写的是意图，这里才是实际值。" />
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto"
                                  Padding="2">
                        <TextBox x:Name="ArgsBox"
                                 IsReadOnly="True"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="6,4"
                                 FontFamily="{StaticResource MonoFont}"
                                 FontSize="11.5"
                                 Foreground="{DynamicResource FgPrimary}"
                                 TextWrapping="NoWrap"
                                 ToolTip="只读，不能在这里修改。&#x0A;路径是相对工作台根目录解析的；长字符串不会换行，可以横向滚动看全。" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== 底部操作条 ===== -->
        <Border Grid.Row="2"
                Background="{DynamicResource Chrome}"
                BorderBrush="{DynamicResource LineStrong}"
                BorderThickness="0,1,0,0"
                Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0"
                          x:Name="SessionCheck"
                          Content="本次会话内不再询问此类操作（敏感文件除外）"
                          Foreground="{DynamicResource FgMuted}"
                          FontSize="11"
                          VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="DenyButton"
                            Content="拒绝"
                            Width="92" Height="28"
                            Margin="0,0,8,0"
                            Click="OnDeny"
                            ToolTip="不执行。模型会收到「用户拒绝」，多数情况下它会换个办法或来问你。&#x0A;这是唯一没有副作用的选项，拿不准就点它。" />
                    <Button x:Name="AllowButton"
                            Content="允许"
                            Width="92" Height="28"
                            Click="OnAllow"
                            Background="{DynamicResource Accent}"
                            Foreground="White"
                            BorderBrush="{DynamicResource AccentBorder}"
                            ToolTip="执行这一次。&#x0A;执行完仍会记进日志和工具调用流水，事后可以查。&#x0A;若这是「禁止一键放行」的高危动作，下面的复选框会被禁用。" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

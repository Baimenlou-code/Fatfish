<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>FatFish.Core.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <!--
      runner 用 2.8.2 而不是 3.0.0：
      3.x 主要面向 xunit.v3，虽然向下兼容 v2，但 2.8.2 是 v2 的经典稳定组合，
      在 net10.0 上验证过的成功率更高。等确实需要 xunit.v3 时再升。
    -->
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FatFish.Core\FatFish.Core.csproj" />
  </ItemGroup>

</Project>
